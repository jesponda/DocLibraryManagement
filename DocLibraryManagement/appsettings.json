{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=DocLibraryManagement-Dev;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Autenticacion": {
    // "Local" = lista de usuarios de la aplicación, con usuario y contraseña (sin Active Directory). "Windows" = Active Directory
    // (Negotiate). "Desarrollo" = usuarios simulados, solo en Development.
    "Modo": "Local",
    // Solo se usa si todavía no existe ninguna cuenta con contraseña: crea al primer Administrador. Si ContrasenaTemporal se deja
    // vacía, se genera una y se escribe UNA vez en el registro de la aplicación. Debe cambiarse al entrar.
    "AdministradorInicial": { "Usuario": "admin", "Nombre": "Administrador", "ContrasenaTemporal": "" }
  },
  "Documentos": {
    // Primer segmento del código de los documentos: SITIO-TIPO-ÁREA-UNIDAD-NNN (p. ej. QRT-F-QA-II-001). Vacío = sin sitio.
    "CodigoSitio": "QRT"
  },
  "Archivos": {
    // Carpeta del almacén (local o de red, FUERA de wwwroot). Vacío = App_Data/archivos junto a la aplicación.
    "RutaBase": "",
    "TamanoMaximoMb": 50
  },
  "TareasDeFondo": {
    // Cada cuántos minutos: poner en vigor revisiones aprobadas con fecha futura que ya llegó e indexar el texto de PDF
    // ya publicados. 0 = desactivadas.
    "MinutosEntreEjecuciones": 5
  },
  "Correo": {
    // Desactivado = no se encola ni envía nada (valor seguro por defecto). Carpeta = guarda .eml (desarrollo). Smtp = servidor real.
    "Modo": "Desactivado",
    "Servidor": "",
    "Puerto": 25,
    // Auto | Ninguna | StartTls | Ssl
    "Seguridad": "Auto",
    "Usuario": "",
    // NO poner la clave aquí: usar la variable de entorno Correo__Clave o user secrets.
    "Clave": "",
    "Remitente": "",
    "NombreRemitente": "Gestión documental",
    // Cómo armar el correo de quien no tiene uno capturado. Ejemplo: "{usuario}@empresa.com"
    "PatronCorreo": "",
    // Dirección pública del sistema, para los enlaces de los correos. Ejemplo: "https://documentos.empresa.com"
    "UrlBase": "",
    "CarpetaSalida": "",
    "MaximoIntentos": 5,
    "MinutosReintento": 5,
    "SegundosEntreEnvios": 30,
    "MinutosArriendo": 10
    // Para cambiar un texto: "Plantillas": { "TareaAsignada": { "Asunto": "…", "Cuerpo": "…" } }
    // Eventos: TareaAsignada, Rechazada, Publicada, AprobacionRevocada, VigenciaReprogramada.
    // Valores disponibles: {Destinatario} {Codigo} {Titulo} {Etiqueta} {Enlace} {EnlaceVisor} {Etapa} {TipoEtapa} {Autor} {Actor} {Motivo} {Fecha}
  },
  "Autorizacion": {
    "MinutosCache": 10,
    // EJEMPLO: reemplazar por los grupos reales de AD (formato DOMINIO\Grupo).
    "Grupos": [
      { "Grupo": "DOMINIO\\DocLib-Administradores", "Rol": "Administrador" },
      { "Grupo": "DOMINIO\\DocLib-Auditores", "Rol": "Auditor" },
      { "Grupo": "DOMINIO\\DocLib-Aprobadores", "Rol": "Aprobador" },
      { "Grupo": "DOMINIO\\DocLib-Revisores", "Rol": "Revisor" },
      { "Grupo": "DOMINIO\\DocLib-Autores-Calidad", "Rol": "Autor", "Areas": [ "CAL" ] }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
