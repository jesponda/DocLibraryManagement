{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=DocLibraryManagement-Dev;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Autenticacion": {
    // "Windows" = Active Directory (Negotiate). "Desarrollo" = usuarios simulados, solo en Development.
    "Modo": "Windows"
  },
  "Archivos": {
    // Carpeta del almacén (local o de red, FUERA de wwwroot). Vacío = App_Data/archivos junto a la aplicación.
    "RutaBase": "",
    "TamanoMaximoMb": 50
  },
  "Autorizacion": {
    "MinutosCache": 10,
    // EJEMPLO: reemplazar por los grupos reales de AD (formato DOMINIO\Grupo).
    "Grupos": [
      { "Grupo": "DOMINIO\\DocLib-Administradores", "Rol": "Administrador" },
      { "Grupo": "DOMINIO\\DocLib-Auditores", "Rol": "Auditor" },
      { "Grupo": "DOMINIO\\DocLib-Aprobadores", "Rol": "Aprobador" },
      { "Grupo": "DOMINIO\\DocLib-Revisores", "Rol": "Revisor" },
      { "Grupo": "DOMINIO\\DocLib-Autores-Calidad", "Rol": "Autor", "Areas": [ "CAL" ] }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
