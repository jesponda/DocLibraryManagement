{
  "ConnectionStrings": {
    // La rama V2 usa su propia base de desarrollo: así no se mezcla con la de la rama main (el modelo cambió).
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=DocLibraryManagement-V2-Dev;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Autenticacion": {
    // Cambiar a "Windows" para probar el SSO real con tu cuenta de dominio.
    "Modo": "Desarrollo"
  },
  "Correo": {
    // En desarrollo los correos se guardan como .eml en App_Data/correo: se pueden abrir sin servidor SMTP.
    "Modo": "Carpeta",
    "Remitente": "documentos@planta.local",
    "PatronCorreo": "{usuario}@planta.local",
    "UrlBase": "http://localhost:5273"
  },
  "Desarrollo": {
    "Personas": [
      { "Id": "lector", "Nombre": "Laura Lectora", "Roles": [ "Lector" ] },
      // El autor de demostración puede crear en todas las áreas del catálogo estándar de Calidad (y en CAL, del catálogo anterior).
      { "Id": "autor-cal", "Nombre": "Alberto Autor (Calidad)", "Roles": [ "Autor" ], "Areas": [ "QA", "PR", "ENG", "MT", "IT", "FN", "HR", "EHS", "SGD", "CAL" ] },
      { "Id": "revisor", "Nombre": "Rosa Revisora", "Roles": [ "Revisor" ] },
      { "Id": "aprobador", "Nombre": "Andrés Aprobador", "Roles": [ "Aprobador" ] },
      { "Id": "auditor", "Nombre": "Aurora Auditora", "Roles": [ "Auditor" ] },
      { "Id": "admin", "Nombre": "Adrián Administrador", "Roles": [ "Administrador" ] }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
