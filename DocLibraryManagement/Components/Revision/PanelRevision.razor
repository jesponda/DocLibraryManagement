@inherits PaginaBase
@using DocLibraryManagement.Application.Archivos
@using DocLibraryManagement.Application.Comun
@using DocLibraryManagement.Application.Documentos
@using DocLibraryManagement.Application.Flujo
@using DocLibraryManagement.Domain
@using Microsoft.Extensions.Options
@inject IRevisionService Revisiones
@inject IFlujoService Flujo
@inject IOptions<ArchivosOptions> OpcionesArchivos
@inject NavigationManager Navegacion

<Mensajes Error="@Error" Exito="@Exito" />

@if (rev is null)
{
    @if (Error is null)
    {
        <p>Cargando…</p>
    }
}
else
{
    <div class="card mb-3" style="max-width: 56rem">
        <div class="card-header d-flex justify-content-between">
            <strong>@rev.Etiqueta</strong>
            <span class="badge text-bg-secondary">@Presentacion.NombreEstado(rev.Estado)</span>
        </div>
        <div class="card-body">

            @if (!string.IsNullOrEmpty(rev.ComentarioUltimoRechazo))
            {
                <div class="alert alert-warning">
                    <strong>Esta revisión fue rechazada.</strong> Corrige lo indicado y vuelve a enviarla.<br />
                    @rev.ComentarioUltimoRechazo
                </div>
            }

            <h2 class="h6">Cambio</h2>
            @if (puedeEditar)
            {
                <div class="mb-2">
                    <label class="form-label" for="motivo">Motivo del cambio</label>
                    <input id="motivo" class="form-control" maxlength="1000" @bind="motivo" />
                </div>
                <div class="mb-2">
                    <label class="form-label" for="descripcion">Descripción <span class="text-muted">(opcional)</span></label>
                    <textarea id="descripcion" class="form-control" rows="3" maxlength="4000" @bind="descripcion"></textarea>
                </div>
                <button class="btn btn-outline-primary btn-sm" @onclick="GuardarCambioAsync">Guardar</button>
            }
            else
            {
                <p class="mb-1"><strong>Motivo:</strong> @rev.MotivoCambio</p>
                @if (!string.IsNullOrWhiteSpace(rev.DescripcionCambio))
                {
                    <p class="mb-1">@rev.DescripcionCambio</p>
                }
            }
            <p class="text-muted small mb-0">Elaborada por @rev.Autor el @rev.FechaCreacionUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm").</p>

            @if (rev.Estado == EstadoRevision.Vigente && rev.FechaVigenciaUtc is not null)
            {
                <p class="mb-0 mt-2">
                    <strong>Vigente desde</strong> @rev.FechaVigenciaUtc.Value.ToLocalTime().ToString("dd/MM/yyyy").
                    @if (rev.FechaProximaRevisionUtc is not null)
                    {
                        <span><strong>Próxima revisión periódica:</strong> @rev.FechaProximaRevisionUtc.Value.ToLocalTime().ToString("dd/MM/yyyy").</span>
                    }
                </p>
            }
            else if (rev.Estado == EstadoRevision.Aprobado && rev.FechaVigenciaUtc is not null)
            {
                <div class="alert alert-info mt-2 mb-0">
                    Aprobada. <strong>Entrará en vigor el @rev.FechaVigenciaUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong>;
                    mientras tanto sigue vigente la revisión anterior.
                </div>
            }
            else if (rev.Estado == EstadoRevision.Obsoleto)
            {
                <div class="alert alert-secondary mt-2 mb-0">
                    <strong>OBSOLETA.</strong> Esta revisión fue reemplazada y se conserva solo para consulta de auditoría. No debe usarse.
                </div>
            }
            else if (rev.Estado == EstadoRevision.Cancelado)
            {
                <div class="alert alert-secondary mt-2 mb-0">Este borrador fue cancelado y no llegó a emitirse.</div>
            }

            <hr />
            <h2 class="h6">Archivos</h2>
            <div class="mb-3">
                <strong>PDF publicado</strong>
                @if (rev.TienePdf)
                {
                    <a class="ms-2" href="archivos/@rev.Id/pdf" target="_blank" rel="noopener">Ver PDF</a>
                    <span class="text-muted small ms-2" title="@rev.HashPdf">SHA-256 @Corto(rev.HashPdf)</span>
                }
                else
                {
                    <span class="text-danger ms-2">Falta (obligatorio para enviar a revisión)</span>
                }
                @if (puedeEditar)
                {
                    <div><InputFile OnChange="@(e => SubirAsync(e, TipoArchivo.Pdf))" accept=".pdf" class="form-control form-control-sm mt-1" aria-label="Subir PDF" /></div>
                }
            </div>
            <div>
                <strong>Fuente editable</strong> <span class="text-muted small">(opcional)</span>
                @if (rev.TieneFuente)
                {
                    @if (esGestor)
                    {
                        <a class="ms-2" href="archivos/@rev.Id/fuente">Descargar</a>
                    }
                    <span class="text-muted small ms-2" title="@rev.HashFuente">SHA-256 @Corto(rev.HashFuente)</span>
                }
                else
                {
                    <span class="text-muted ms-2">No cargada</span>
                }
                @if (puedeEditar)
                {
                    <div><InputFile OnChange="@(e => SubirAsync(e, TipoArchivo.Fuente))" accept=".doc,.docx,.xls,.xlsx,.xlsm,.odt,.ods" class="form-control form-control-sm mt-1" aria-label="Subir fuente editable" /></div>
                }
            </div>
            @if (puedeEditar)
            {
                <p class="text-muted small mt-2 mb-0">Tamaño máximo: @OpcionesArchivos.Value.TamanoMaximoMb MB. Subir de nuevo reemplaza el archivo.</p>
            }

            @if (puedeEditar)
            {
                <hr />
                <button class="btn btn-primary" @onclick="AbrirEnvioAsync" disabled="@(!rev.TienePdf)">Enviar a revisión…</button>
                @if (rev.EsPrimeraEmision)
                {
                    <button class="btn btn-outline-danger ms-2" @onclick="() => confirmandoCancelacion = !confirmandoCancelacion">Cancelar este documento…</button>
                }
                else
                {
                    <button class="btn btn-outline-danger ms-2" @onclick="() => confirmandoDescarte = !confirmandoDescarte">Descartar este borrador…</button>
                }
            }
        </div>
    </div>

    @if (puedeEditar && confirmandoCancelacion)
    {
        <div class="card border-danger mb-3" style="max-width: 56rem">
            <div class="card-body">
                <p>El documento quedará <strong>Retirado</strong> y su código no se volverá a usar. Esto no se puede deshacer.</p>
                <label class="form-label" for="motivoCancelacion">Motivo</label>
                <input id="motivoCancelacion" class="form-control mb-2" maxlength="1000" @bind="motivoCancelacion" />
                <button class="btn btn-danger" @onclick="CancelarDocumentoAsync">Cancelar documento</button>
                <button class="btn btn-link" @onclick="() => confirmandoCancelacion = false">Volver</button>
            </div>
        </div>
    }

    @if (puedeEditar && confirmandoDescarte)
    {
        <div class="card border-danger mb-3" style="max-width: 56rem">
            <div class="card-body">
                <p>El borrador se descartará y <strong>@rev.Etiqueta</strong> volverá a estar disponible para la próxima revisión. La revisión vigente no se afecta.</p>
                <label class="form-label" for="motivoDescarte">Motivo</label>
                <input id="motivoDescarte" class="form-control mb-2" maxlength="1000" @bind="motivoDescarte" />
                <button class="btn btn-danger" @onclick="DescartarBorradorAsync">Descartar borrador</button>
                <button class="btn btn-link" @onclick="() => confirmandoDescarte = false">Volver</button>
            </div>
        </div>
    }

    @if (puedeEditar && enviando)
    {
        <div class="card border-primary mb-3" style="max-width: 56rem">
            <div class="card-header">Enviar a revisión</div>
            <div class="card-body">
                @if (plan is { EsMenor: true })
                {
                    <p>Es una <strong>revisión menor</strong> (corrección editorial): se aprueba en una sola etapa.</p>
                    @if (plan.DuenoId is null)
                    {
                        <div class="alert alert-warning mb-2">
                            Esta área no tiene un dueño designado para aprobar revisiones menores. Pide a un Administrador que lo designe.
                        </div>
                    }
                    else
                    {
                        <p>La aprobará el dueño del área: <strong>@plan.NombreDueno</strong>.</p>
                        <button class="btn btn-primary" @onclick="EnviarAsync">Enviar</button>
                    }
                }
                else if (plantilla.Count == 0)
                {
                    <div class="alert alert-warning mb-0">Este tipo de documento no tiene un flujo configurado. Pide a un Administrador que lo configure.</div>
                }
                else
                {
                    <p>Elige quién realizará cada etapa. Quien elabora la revisión no puede revisarla ni aprobarla.</p>
                    @foreach (var paso in plantilla)
                    {
                        var personas = CandidatosDe(paso.Clase);
                        <div class="mb-2">
                            <label class="form-label" for="paso-@paso.Orden">@paso.Orden. @paso.Nombre <span class="text-muted">(@(paso.Clase == TipoPaso.Revision ? "revisión" : "aprobación"))</span></label>
                            @if (personas.Count == 0)
                            {
                                <div class="text-danger small">No hay personas con el rol @paso.Clase.RolRequerido(). Solo aparecen quienes ya han entrado al sistema.</div>
                            }
                            else
                            {
                                <select id="paso-@paso.Orden" class="form-select" value="@AsignadoA(paso.Orden)" @onchange="e => Asignar(paso.Orden, e.Value?.ToString())">
                                    <option value="">Selecciona…</option>
                                    @foreach (var c in personas)
                                    {
                                        <option value="@c.UsuarioId">@c.Nombre</option>
                                    }
                                </select>
                            }
                        </div>
                    }
                    <button class="btn btn-primary" @onclick="EnviarAsync" disabled="@(!plantilla.All(p => asignaciones.ContainsKey(p.Orden)))">Enviar</button>
                }
                <button class="btn btn-link" @onclick="() => enviando = false">Cerrar</button>
            </div>
        </div>
    }

    @if (historial.Count > 0)
    {
        <h2 class="h5">Flujo de aprobación</h2>
        @foreach (var (instancia, indice) in historial.Select((i, n) => (i, n)))
        {
            <details class="mb-3" open="@(indice == 0)" style="max-width: 56rem">
                <summary>
                    Envío #@instancia.Numero – <strong>@NombreFlujo(instancia.Estado)</strong>
                    <span class="text-muted small"> (iniciado por @instancia.IniciadoPor, @instancia.FechaInicioUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))</span>
                </summary>
                <table class="table table-sm align-middle mt-2">
                    <thead><tr><th>#</th><th>Etapa</th><th>Asignado a</th><th>Estado</th><th>Decisión</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var p in instancia.Pasos)
                    {
                        var esVigente = instancia.Estado == EstadoFlujo.EnCurso && p.Id == PasoVigenteId(instancia);
                        <tr class="@(esVigente ? "table-active" : "")">
                            <td>@p.Orden</td>
                            <td>@p.Nombre</td>
                            <td>@p.AsignadoA</td>
                            <td>@NombrePaso(p.Estado)</td>
                            <td>
                                @if (p.FechaDecisionUtc is not null)
                                {
                                    <span>@p.DecididoPor, @p.FechaDecisionUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                    @if (!string.IsNullOrEmpty(p.Comentario))
                                    {
                                        <div class="small">«@p.Comentario»</div>
                                    }
                                }
                            </td>
                            <td>
                                @if (esVigente && puedeGestionarFlujo)
                                {
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => IniciarReasignacion(p)">Reasignar</button>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </details>
        }
    }

    @if (reasignando is not null)
    {
        <div class="card mb-3" style="max-width: 56rem">
            <div class="card-header">Reasignar «@reasignando.Nombre»</div>
            <div class="card-body">
                <div class="mb-2">
                    <label class="form-label" for="nuevoResp">Nueva persona</label>
                    <select id="nuevoResp" class="form-select" @bind="nuevoResponsable">
                        <option value="">Selecciona…</option>
                        @foreach (var c in CandidatosDe(reasignando.Clase).Where(c => c.UsuarioId != reasignando.AsignadoAId))
                        {
                            <option value="@c.UsuarioId">@c.Nombre</option>
                        }
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label" for="motivoReasignar">Motivo</label>
                    <input id="motivoReasignar" class="form-control" maxlength="2000" @bind="motivoReasignacion" />
                </div>
                <button class="btn btn-primary" @onclick="ReasignarAsync">Reasignar</button>
                <button class="btn btn-link" @onclick="() => reasignando = null">Cerrar</button>
            </div>
        </div>
    }

    @if (miTarea is not null)
    {
        <div class="card border-success mb-3" style="max-width: 56rem">
            <div class="card-header">Tu decisión: «@miTarea.NombrePaso»</div>
            <div class="card-body">
                <p class="mb-2">Revisa el PDF y decide. Si rechazas, explica qué debe corregirse.</p>
                <label class="form-label" for="comentario">Comentario <span class="text-muted">(obligatorio al rechazar)</span></label>
                <textarea id="comentario" class="form-control mb-2" rows="3" maxlength="2000" @bind="comentarioDecision"></textarea>
                @if (EsUltimaEtapa)
                {
                    <div class="mb-2" style="max-width: 20rem">
                        <label class="form-label" for="vigencia">Entra en vigor a partir de <span class="text-muted">(opcional)</span></label>
                        <input id="vigencia" type="date" class="form-control" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")"
                               value="@vigenciaTexto" @onchange="e => vigenciaTexto = e.Value?.ToString() ?? string.Empty" />
                        <div class="form-text">
                            Esta es la <strong>última etapa</strong>: al aprobar, la revisión se publica y la anterior queda obsoleta.
                            Si dejas la fecha vacía es de inmediato; con una fecha futura, la anterior sigue vigente hasta entonces.
                        </div>
                    </div>
                }
                <button class="btn btn-success" @onclick="() => DecidirAsync(true)">Aprobar</button>
                <button class="btn btn-danger ms-2" @onclick="() => DecidirAsync(false)">Rechazar</button>
            </div>
        </div>
    }

    @if (puedeGestionarFlujo && historial.FirstOrDefault() is { Estado: EstadoFlujo.EnCurso })
    {
        <div class="mb-3" style="max-width: 56rem">
            <button class="btn btn-outline-danger btn-sm" @onclick="() => cancelandoFlujo = !cancelandoFlujo">Cancelar el flujo…</button>
            @if (cancelandoFlujo)
            {
                <div class="mt-2">
                    <label class="form-label" for="motivoFlujo">Motivo (la revisión vuelve a Borrador)</label>
                    <input id="motivoFlujo" class="form-control mb-2" maxlength="2000" @bind="motivoCancelacionFlujo" />
                    <button class="btn btn-danger btn-sm" @onclick="CancelarFlujoAsync">Confirmar cancelación</button>
                </div>
            }
        </div>
    }
}

@code {
    [Parameter] public int RevisionId { get; set; }

    /// <summary>Se dispara tras cualquier cambio para que la página recargue la lista de revisiones.</summary>
    [Parameter] public EventCallback OnCambio { get; set; }

    private RevisionDetalleDto? rev;
    private List<InstanciaFlujoDto> historial = [];
    private TareaPendienteDto? miTarea;
    private bool esGestor;
    private bool puedeEditar;
    private bool puedeGestionarFlujo;

    private string motivo = "";
    private string descripcion = "";

    private bool enviando;
    private PlanEnvioDto? plan;
    private List<PasoPlantillaDto> plantilla = [];
    private readonly Dictionary<TipoPaso, List<CandidatoDto>> candidatos = [];
    private readonly Dictionary<int, Guid> asignaciones = [];

    private bool confirmandoCancelacion;
    private string motivoCancelacion = "";

    private bool confirmandoDescarte;
    private string motivoDescarte = "";

    private bool cancelandoFlujo;
    private string motivoCancelacionFlujo = "";

    private string vigenciaTexto = "";

    /// <summary>La etapa que decide el usuario es la última del flujo: aprobarla publica la revisión.</summary>
    private bool EsUltimaEtapa =>
        miTarea is not null
        && historial.FirstOrDefault() is { } actual
        && actual.Pasos.Where(p => p.Estado == EstadoPaso.Pendiente).Count() == 1
        && actual.Pasos.Any(p => p.Id == miTarea.PasoId && p.Estado == EstadoPaso.Pendiente);

    private PasoInstanciaDto? reasignando;
    private string nuevoResponsable = "";
    private string motivoReasignacion = "";

    private string comentarioDecision = "";

    protected override async Task OnParametersSetAsync() => await RecargarAsync(conservarMensajes: false);

    private async Task RecargarAsync(bool conservarMensajes = true)
    {
        var error = Error;
        var exito = Exito;

        await EjecutarAsync(async a =>
        {
            rev = await Revisiones.ObtenerAsync(a, RevisionId);
            esGestor = a.EsAdministrador || a.TieneRol(RolSistema.Auditor) || a.PuedeEditarEnArea(rev.CodigoArea);
            puedeEditar = rev.Estado == EstadoRevision.Borrador && a.PuedeEditarEnArea(rev.CodigoArea);
            puedeGestionarFlujo = a.PuedeEditarEnArea(rev.CodigoArea);

            motivo = rev.MotivoCambio;
            descripcion = rev.DescripcionCambio ?? "";

            // El historial y las tareas solo existen para quien ve el flujo; si no hay permiso queda vacío.
            historial = [.. await Flujo.HistorialAsync(a, RevisionId)];
            miTarea = (await Flujo.MisTareasAsync(a)).FirstOrDefault(t => t.RevisionId == RevisionId);
        });

        if (conservarMensajes && Error is null && Exito is null)
        {
            Error = error;
            Exito = exito;
        }
    }

    private async Task NotificarAsync()
    {
        await RecargarAsync();
        await OnCambio.InvokeAsync();
    }

    private async Task GuardarCambioAsync()
    {
        if (await EjecutarAsync(a => Revisiones.ActualizarBorradorAsync(a, RevisionId, motivo, descripcion), "Cambios guardados."))
        {
            await NotificarAsync();
        }
    }

    private async Task SubirAsync(InputFileChangeEventArgs e, TipoArchivo tipo)
    {
        var archivo = e.File;
        var ok = await EjecutarAsync(async a =>
        {
            Stream flujo;
            try
            {
                // Blazor rechaza aquí el archivo si supera el límite (con un margen para que lo mida el servicio).
                flujo = archivo.OpenReadStream(OpcionesArchivos.Value.TamanoMaximoBytes + 1);
            }
            catch (IOException)
            {
                throw new ReglaNegocioException($"El archivo supera el tamaño máximo de {OpcionesArchivos.Value.TamanoMaximoMb} MB.");
            }

            await using (flujo)
            {
                await Revisiones.SubirArchivoAsync(a, RevisionId, tipo, archivo.Name, flujo);
            }
        }, "Archivo cargado.");

        if (ok)
        {
            await NotificarAsync();
        }
    }

    // ---------- Enviar a revisión ----------

    private async Task AbrirEnvioAsync()
    {
        enviando = true;
        asignaciones.Clear();
        await EjecutarAsync(async _ =>
        {
            plan = await Flujo.ObtenerPlanEnvioAsync(rev!.Id);
            plantilla = [.. plan.Pasos];
            if (plan.EsMenor)
            {
                return; // la única etapa es del dueño del área: no hay nada que elegir
            }

            foreach (var clase in plantilla.Select(p => p.Clase).Distinct())
            {
                // El autor de la revisión nunca es candidato: el servicio también lo rechazaría.
                candidatos[clase] = [.. (await Flujo.CandidatosAsync(clase)).Where(c => c.UsuarioId != rev!.AutorId)];
            }
        });
    }

    private List<CandidatoDto> CandidatosDe(TipoPaso clase) => candidatos.GetValueOrDefault(clase) ?? [];

    private string AsignadoA(int orden) => asignaciones.TryGetValue(orden, out var id) ? id.ToString() : "";

    private void Asignar(int orden, string? valor)
    {
        if (Guid.TryParse(valor, out var id))
        {
            asignaciones[orden] = id;
        }
        else
        {
            asignaciones.Remove(orden);
        }
    }

    private async Task EnviarAsync()
    {
        var lista = asignaciones.Select(kv => new AsignacionPaso(kv.Key, kv.Value)).ToList();
        if (await EjecutarAsync(a => Flujo.IniciarAsync(a, RevisionId, lista), "La revisión se envió al flujo de aprobación."))
        {
            enviando = false;
            await NotificarAsync();
        }
    }

    // ---------- Decisión, reasignación y cancelaciones ----------

    private async Task DecidirAsync(bool aprobar)
    {
        DateTime? vigenciaUtc = null;
        if (aprobar && EsUltimaEtapa && DateOnly.TryParse(vigenciaTexto, out var fecha))
        {
            // El usuario elige un día; entra en vigor a las 00:00 de ese día en la hora local de la planta.
            var local = DateTime.SpecifyKind(fecha.ToDateTime(TimeOnly.MinValue), DateTimeKind.Unspecified);
            vigenciaUtc = TimeZoneInfo.ConvertTimeToUtc(local, TimeZoneInfo.Local);
        }

        var etiquetaPublica = aprobar && EsUltimaEtapa;
        if (await EjecutarAsync(a => Flujo.DecidirAsync(a, miTarea!.PasoId, aprobar, comentarioDecision, vigenciaUtc),
                !aprobar ? "Rechazaste la revisión; regresó a borrador."
                : etiquetaPublica ? "Aprobaste la última etapa: la revisión quedó publicada (o programada para su fecha)."
                : "Aprobaste la etapa."))
        {
            comentarioDecision = "";
            vigenciaTexto = "";
            await NotificarAsync();
        }
    }

    private async Task DescartarBorradorAsync()
    {
        if (await EjecutarAsync(a => Revisiones.CancelarBorradorAsync(a, RevisionId, motivoDescarte), "Borrador descartado."))
        {
            confirmandoDescarte = false;
            motivoDescarte = "";
            await NotificarAsync();
        }
    }

    private void IniciarReasignacion(PasoInstanciaDto paso)
    {
        reasignando = paso;
        nuevoResponsable = "";
        motivoReasignacion = "";
        _ = CargarCandidatosAsync(paso.Clase);
    }

    private async Task CargarCandidatosAsync(TipoPaso clase)
    {
        if (!candidatos.ContainsKey(clase))
        {
            candidatos[clase] = [.. (await Flujo.CandidatosAsync(clase)).Where(c => c.UsuarioId != rev!.AutorId)];
            StateHasChanged();
        }
    }

    private async Task ReasignarAsync()
    {
        if (!Guid.TryParse(nuevoResponsable, out var id))
        {
            Error = "Elige a la nueva persona.";
            return;
        }

        if (await EjecutarAsync(a => Flujo.ReasignarAsync(a, reasignando!.Id, id, motivoReasignacion), "Etapa reasignada."))
        {
            reasignando = null;
            await NotificarAsync();
        }
    }

    private async Task CancelarFlujoAsync()
    {
        if (await EjecutarAsync(a => Flujo.CancelarFlujoAsync(a, RevisionId, motivoCancelacionFlujo), "El flujo se canceló; la revisión volvió a borrador."))
        {
            cancelandoFlujo = false;
            motivoCancelacionFlujo = "";
            await NotificarAsync();
        }
    }

    private async Task CancelarDocumentoAsync()
    {
        if (await EjecutarAsync(a => Revisiones.CancelarDocumentoNuevoAsync(a, rev!.DocumentoId, motivoCancelacion)))
        {
            Navegacion.NavigateTo("documentos");
        }
    }

    // ---------- Presentación ----------

    private static int PasoVigenteId(InstanciaFlujoDto i) =>
        i.Pasos.Where(p => p.Estado == EstadoPaso.Pendiente).OrderBy(p => p.Orden).Select(p => p.Id).FirstOrDefault();

    private static string Corto(string? hash) => hash is { Length: > 12 } ? hash[..12] + "…" : hash ?? "";

    private static string NombreFlujo(EstadoFlujo e) => e switch
    {
        EstadoFlujo.EnCurso => "En curso",
        EstadoFlujo.Aprobado => "Aprobado",
        EstadoFlujo.Rechazado => "Rechazado",
        EstadoFlujo.Cancelado => "Cancelado",
        _ => e.ToString(),
    };

    private static string NombrePaso(EstadoPaso e) => e switch
    {
        EstadoPaso.Pendiente => "Pendiente",
        EstadoPaso.Aprobado => "Aprobada",
        EstadoPaso.Rechazado => "Rechazada",
        EstadoPaso.Omitido => "Omitida",
        _ => e.ToString(),
    };
}
