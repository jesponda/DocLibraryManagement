@using DocLibraryManagement.Application.Flujo
@using DocLibraryManagement.Application.Vencimientos
@using DocLibraryManagement.Seguridad
@inject NavigationManager Navegacion
@inject ProveedorActor ProveedorActor
@inject IFlujoService Flujo
@inject IVencimientosService Vencimientos

<div class="logo">
    <div class="logo-top">
        <img class="logo-img" alt="Allegion" src="img/allegion.png" />
        <button type="button" class="collapse-btn" data-sgd="ocultar" aria-label="Ocultar el menú" title="Ocultar el menú">☰</button>
    </div>
    <b>SGD</b><span>Allegion Querétaro</span>
</div>

<AuthorizeView>
    <Authorized>
        <a class="@Clase("", exacto: true)" href="">Inicio</a>
        <a class="@Clase("lista-maestra")" href="lista-maestra">Lista maestra</a>
        <a class="@Clase("buscar")" href="buscar">Buscar</a>
    </Authorized>
</AuthorizeView>

<AuthorizeView Policy="@Politicas.PuedeEditarDocumentos">
    <a class="@Clase("documentos/nuevo")" href="documentos/nuevo">Nuevo documento</a>
</AuthorizeView>

<AuthorizeView Roles="Autor,Administrador,Auditor">
    <a class="@Clase("documentos", excluir: "documentos/nuevo")" href="documentos">Documentos</a>
</AuthorizeView>

<AuthorizeView Roles="Revisor,Aprobador">
    <a class="@Clase("pendientes")" href="pendientes">Mis tareas @if (pendientes > 0) { <span class="badge text-bg-warning">@pendientes</span> }</a>
</AuthorizeView>

<AuthorizeView Roles="Administrador,Auditor,Autor,Aprobador">
    <a class="@Clase("reportes")" href="reportes">Reportes</a>
</AuthorizeView>

<AuthorizeView Roles="Administrador,Auditor">
    <a class="@Clase("auditoria")" href="auditoria">Bitácora</a>
</AuthorizeView>

<AuthorizeView>
    <Authorized>
        <div class="nav-sep"></div>
        <AuthorizeView Policy="@Politicas.PuedeAdministrar" Context="admin">
            <a class="@Clase("administracion")" href="administracion">Administración</a>
        </AuthorizeView>
        <a class="@Clase("mi-acceso")" href="mi-acceso">Mi acceso</a>
    </Authorized>
</AuthorizeView>

@code {
    [CascadingParameter] private Task<AuthenticationState>? EstadoAutenticacion { get; set; }

    private int pendientes;

    /// <summary>Lo que espera a quien revisa o aprueba: etapas de flujo y solicitudes «revisado sin cambios» por decidir.</summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var estado = EstadoAutenticacion is null ? null : await EstadoAutenticacion;
            if (estado?.User.Identity?.IsAuthenticated == true && (estado.User.IsInRole("Revisor") || estado.User.IsInRole("Aprobador")))
            {
                var actor = await ProveedorActor.ObtenerAsync();
                pendientes = (await Flujo.MisTareasAsync(actor)).Count + (await Vencimientos.PendientesDeDecisionAsync(actor)).Count;
            }
        }
        catch (Exception)
        {
            pendientes = 0; // el menú nunca debe fallar por el contador
        }
    }

    /// <summary>Marca como activa la opción de la ruta actual. «excluir» evita que «Documentos» se marque junto a «Nuevo documento».</summary>
    private string Clase(string prefijo, bool exacto = false, string? excluir = null)
    {
        var ruta = Navegacion.ToBaseRelativePath(Navegacion.Uri).Split('?', '#')[0].Trim('/');

        var activa = exacto
            ? ruta.Length == 0
            : (ruta == prefijo || ruta.StartsWith(prefijo + "/", StringComparison.OrdinalIgnoreCase));

        if (activa && excluir is not null && (ruta == excluir || ruta.StartsWith(excluir + "/", StringComparison.OrdinalIgnoreCase)))
        {
            activa = false;
        }

        return activa ? "sgd-nav active" : "sgd-nav";
    }
}
