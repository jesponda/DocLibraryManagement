        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Inicio
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="lista-maestra">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Lista maestra
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="buscar">
                        <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Buscar
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="mi-acceso">
                        <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> Mi acceso
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="Autor,Administrador,Auditor">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="documentos" Match="NavLinkMatch.Prefix">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Documentos
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="Revisor,Aprobador">
