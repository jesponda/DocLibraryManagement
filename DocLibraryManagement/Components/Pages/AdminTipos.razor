@page "/administracion/tipos"
@attribute [Authorize(Policy = Politicas.PuedeAdministrar)]
@rendermode InteractiveServer
@inherits PaginaBase
@using DocLibraryManagement.Application.Catalogo
@inject ICatalogoService Catalogo

<PageTitle>Tipos de documento</PageTitle>

<h1>Tipos de documento</h1>
<p><a href="administracion">← Administración</a></p>

<Mensajes Error="@Error" Exito="@Exito" />

<div class="card mb-4" style="max-width: 40rem">
    <div class="card-body">
        <h2 class="h5">@(editando is null ? "Nuevo tipo" : $"Editando {editando.Codigo}")</h2>
        <div class="row g-2">
            <div class="col-sm-3">
                <label class="form-label" for="codigo">Abreviatura</label>
                <input id="codigo" class="form-control" maxlength="10" @bind="codigo" disabled="@(editando is not null)" />
            </div>
            <div class="col-sm-6">
                <label class="form-label" for="nombre">Nombre</label>
                <input id="nombre" class="form-control" maxlength="200" @bind="nombre" />
            </div>
            <div class="col-sm-3">
                <label class="form-label" for="meses">Revisar cada (meses)</label>
                <input id="meses" type="number" class="form-control" min="1" max="120" @bind="meses" />
            </div>
        </div>
        @if (editando is not null)
        {
            <div class="form-check mt-2">
                <input id="activo" type="checkbox" class="form-check-input" @bind="activo" />
                <label class="form-check-label" for="activo">Activo (si se desactiva, no admite documentos nuevos)</label>
            </div>
        }
        <div class="mt-3">
            <button class="btn btn-primary" @onclick="GuardarAsync">@(editando is null ? "Crear tipo" : "Guardar cambios")</button>
            @if (editando is not null)
            {
                <button class="btn btn-link" @onclick="Cancelar">Cancelar</button>
            }
        </div>
        @if (editando is not null)
        {
            <p class="text-muted small mt-2 mb-0">La abreviatura no se puede cambiar: forma parte del código de los documentos.</p>
        }
    </div>
</div>

@if (tipos is null)
{
    <p>Cargando…</p>
}
else if (tipos.Count == 0)
{
    <p class="text-muted">Todavía no hay tipos de documento.</p>
}
else
{
    <table class="table table-sm align-middle" style="max-width: 50rem">
        <thead><tr><th>Abreviatura</th><th>Nombre</th><th>Revisión</th><th>Estado</th><th></th></tr></thead>
        <tbody>
        @foreach (var t in tipos)
        {
            <tr class="@(t.Activo ? "" : "text-muted")">
                <td><code>@t.Codigo</code></td>
                <td>@t.Nombre</td>
                <td>cada @t.MesesRevision meses</td>
                <td>@(t.Activo ? "Activo" : "Desactivado")</td>
                <td><button class="btn btn-sm btn-outline-secondary" @onclick="() => Editar(t)">Editar</button></td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private List<TipoDocumentoDto>? tipos;
    private TipoDocumentoDto? editando;
    private string codigo = "";
    private string nombre = "";
    private int meses = 12;
    private bool activo = true;

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync() => tipos = [.. await Catalogo.ListarTiposAsync(incluirInactivos: true)];

    private void Editar(TipoDocumentoDto t)
    {
        editando = t;
        codigo = t.Codigo;
        nombre = t.Nombre;
        meses = t.MesesRevision;
        activo = t.Activo;
        Error = Exito = null;
    }

    private void Cancelar()
    {
        editando = null;
        codigo = nombre = "";
        meses = 12;
        activo = true;
    }

    private async Task GuardarAsync()
    {
        var ok = editando is null
            ? await EjecutarAsync(a => Catalogo.CrearTipoAsync(a, codigo, nombre, meses), "Tipo creado.")
            : await EjecutarAsync(a => Catalogo.ActualizarTipoAsync(a, editando.Id, nombre, meses, activo), "Cambios guardados.");

        if (ok)
        {
            Cancelar();
            await CargarAsync();
        }
    }
}
