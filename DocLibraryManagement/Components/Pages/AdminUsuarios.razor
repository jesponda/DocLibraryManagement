@page "/administracion/usuarios"
@attribute [Authorize(Policy = Politicas.PuedeAdministrar)]
@rendermode InteractiveServer
@inherits PaginaBase
@using DocLibraryManagement.Application.Catalogo
@using DocLibraryManagement.Application.Correo
@using DocLibraryManagement.Application.Usuarios
@using DocLibraryManagement.Domain
@using DocLibraryManagement.Seguridad
@using Microsoft.Extensions.Options
@inject ICuentasService Cuentas
@inject IUsuariosService Usuarios
@inject ICatalogoService Catalogo
@inject IConfiguration Configuracion
@inject IOptions<CorreoOptions> OpcionesCorreo

<PageTitle>Usuarios y roles</PageTitle>

<h1>Usuarios y roles</h1>
<p><a href="administracion">← Administración</a></p>

@if (ConfiguracionSeguridad.ObtenerModo(Configuracion) != ConfiguracionSeguridad.ModoLocal)
{
    <div class="alert alert-info" style="max-width: 50rem">
        La aplicación no está en modo de acceso «Local»: los roles vienen de otro origen (grupos de Windows o usuarios de desarrollo),
        así que las cuentas que des de alta aquí no podrán entrar.
    </div>
}

<Mensajes Error="@Error" Exito="@Exito" />

@if (contrasenaTemporal is not null)
{
    <div class="alert alert-warning" role="status" style="max-width: 50rem">
        Contraseña temporal de <strong>@temporalDe</strong>: <code class="fs-5 user-select-all">@contrasenaTemporal</code><br />
        <small>
            Se muestra <strong>una sola vez</strong>. Entrégasela a la persona por un medio seguro; al entrar tendrá que elegir una propia.
            Si se pierde, usa «Restablecer contraseña».
        </small>
        <div class="mt-2"><button class="btn btn-sm btn-outline-secondary" @onclick="() => contrasenaTemporal = null">Ya la entregué</button></div>
    </div>
}

@if (formulario is not null)
{
    <div class="card mb-4" style="max-width: 50rem">
        <div class="card-body">
            <h2 class="h5">@(formulario.Id is null ? "Nuevo usuario" : $"Editar a {formulario.Identificador}")</h2>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label" for="u-id">Nombre de usuario</label>
                    <input id="u-id" class="form-control" maxlength="50" autocomplete="off" disabled="@(formulario.Id is not null)" @bind="formulario.Identificador" />
                    <div class="form-text">Minúsculas, números, punto, guion. No se puede cambiar después. Ej.: jperez</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="u-nombre">Nombre completo</label>
                    <input id="u-nombre" class="form-control" maxlength="200" @bind="formulario.Nombre" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="u-correo">Correo (opcional)</label>
                    <input id="u-correo" class="form-control" maxlength="256" placeholder="nombre@empresa.com" @bind="formulario.Correo" />
                    <div class="form-text">Para los avisos. Si se deja vacío se usa la convención configurada.</div>
                </div>
            </div>

            <fieldset class="mt-3">
                <legend class="fs-6 fw-semibold">Roles <small class="text-muted fw-normal">(todas las personas son Lector)</small></legend>
                @foreach (var (rol, descripcion) in RolesAsignables)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="rol-@rol" checked="@formulario.Roles.Contains(rol)"
                               @onchange="e => AlternarRol(rol, (bool)e.Value!)" />
                        <label class="form-check-label" for="rol-@rol"><strong>@rol</strong> <span class="text-muted">— @descripcion</span></label>
                    </div>
                }
            </fieldset>

            @if (formulario.Roles.Contains(RolSistema.Autor))
            {
                <fieldset class="mt-3">
                    <legend class="fs-6 fw-semibold">Áreas donde puede editar <small class="text-muted fw-normal">(obligatorio para un Autor)</small></legend>
                    <div class="d-flex flex-wrap gap-3">
                        @foreach (var a in areas)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="area-@a.Codigo" checked="@formulario.Areas.Contains(a.Codigo)"
                                       @onchange="e => AlternarArea(a.Codigo, (bool)e.Value!)" />
                                <label class="form-check-label" for="area-@a.Codigo">@a.Nombre <code>@a.Codigo</code></label>
                            </div>
                        }
                    </div>
                    @if (areas.Count == 0)
                    {
                        <div class="text-danger small">Todavía no hay áreas activas: carga el catálogo estándar desde Administración.</div>
                    }
                </fieldset>
            }

            <div class="mt-3 d-flex gap-2">
                <button class="btn btn-primary" @onclick="GuardarAsync" disabled="@ocupado">@(formulario.Id is null ? "Dar de alta" : "Guardar cambios")</button>
                <button class="btn btn-outline-secondary" @onclick="Cancelar">Cancelar</button>
            </div>
        </div>
    </div>
}
else
{
    <p><button class="btn btn-primary" @onclick="Nuevo">Nuevo usuario</button></p>
}

@if (cuentas is null)
{
    <p>Cargando…</p>
}
else if (cuentas.Count == 0)
{
    <p class="text-muted">Todavía no hay usuarios.</p>
}
else
{
    <div class="mb-2" style="max-width: 24rem">
        <input class="form-control form-control-sm" type="search" placeholder="Filtrar por nombre o usuario" aria-label="Filtrar usuarios" @bind="filtro" @bind:event="oninput" />
    </div>
    <table class="table table-sm align-middle">
        <thead><tr><th>Nombre</th><th>Usuario</th><th>Roles</th><th>Áreas</th><th>Correo</th><th>Estado</th><th></th></tr></thead>
        <tbody>
        @foreach (var c in Filtradas())
        {
            <tr class="@(c.Activa ? "" : "text-muted")">
                <td>@c.Nombre</td>
                <td><code>@c.Identificador</code></td>
                <td>@(c.Roles.Count == 0 ? "Lector" : string.Join(", ", c.Roles.Prepend(RolSistema.Lector)))</td>
                <td>@(c.Areas.Count == 0 ? "—" : string.Join(", ", c.Areas))</td>
                <td>
                    @if (correos.TryGetValue(c.Id, out var correo) && correo.CorreoEfectivo is not null)
                    {
                        @correo.CorreoEfectivo
                        <span class="badge text-bg-@(correo.Origen == OrigenCorreo.Explicito ? "primary" : "secondary") ms-1">@(correo.Origen == OrigenCorreo.Explicito ? "capturado" : "convención")</span>
                    }
                    else
                    {
                        <span class="text-danger">Sin correo</span>
                    }
                </td>
                <td>
                    @if (!c.Activa) { <span class="badge text-bg-secondary">Inactivo</span> }
                    else if (c.BloqueadaHastaUtc is not null) { <span class="badge text-bg-danger">Bloqueado</span> }
                    else if (!c.TieneContrasena) { <span class="badge text-bg-light border">Sin contraseña</span> }
                    else if (c.DebeCambiarContrasena) { <span class="badge text-bg-warning">Contraseña temporal</span> }
                    else { <span class="badge text-bg-success">Activo</span> }
                </td>
                <td class="text-nowrap">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => Editar(c)">Editar</button>
                    @if (confirmandoRestablecer == c.Id)
                    {
                        <button class="btn btn-sm btn-warning" @onclick="() => RestablecerAsync(c)">Sí, restablecer</button>
                        <button class="btn btn-sm btn-link" @onclick="() => confirmandoRestablecer = null">No</button>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => confirmandoRestablecer = c.Id">Restablecer contraseña</button>
                    }
                    <button class="btn btn-sm btn-outline-@(c.Activa ? "danger" : "success")" @onclick="() => CambiarEstadoAsync(c)">@(c.Activa ? "Desactivar" : "Activar")</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
    <p class="text-muted small">
        «Restablecer contraseña» genera una temporal nueva, desbloquea la cuenta y cierra sus sesiones abiertas. Desactivar a alguien no borra nada:
        su historial en la bitácora y en los documentos se conserva.
    </p>
}

@code {
    private static readonly (RolSistema Rol, string Descripcion)[] RolesAsignables =
    [
        (RolSistema.Autor, "crea y edita documentos en sus áreas"),
        (RolSistema.Revisor, "revisa documentos en el flujo"),
        (RolSistema.Aprobador, "aprueba documentos en el flujo"),
        (RolSistema.Auditor, "consulta todo, incluida la bitácora (solo lectura)"),
        (RolSistema.Administrador, "gestiona catálogos, flujos y usuarios"),
    ];

    private sealed class Formulario
    {
        public Guid? Id { get; set; }
        public string Identificador { get; set; } = "";
        public string Nombre { get; set; } = "";
        public string? Correo { get; set; }
        public HashSet<RolSistema> Roles { get; } = [];
        public HashSet<string> Areas { get; } = new(StringComparer.OrdinalIgnoreCase);
    }

    private IReadOnlyList<CuentaDto>? cuentas;
    private Dictionary<Guid, UsuarioDto> correos = [];
    private IReadOnlyList<AreaDto> areas = [];
    private Formulario? formulario;
    private string filtro = "";
    private bool ocupado;
    private Guid? confirmandoRestablecer;
    private string? contrasenaTemporal;
    private string? temporalDe;

    protected override async Task OnInitializedAsync()
    {
        areas = (await Catalogo.ListarAreasAsync()).Where(a => a.Activa).OrderBy(a => a.Codigo).ToList();
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        await EjecutarAsync(async a =>
        {
            cuentas = await Cuentas.ListarAsync(a);
            correos = (await Usuarios.ListarAsync(a)).ToDictionary(u => u.Id);
        });
        cuentas ??= [];
    }

    private IEnumerable<CuentaDto> Filtradas() =>
        string.IsNullOrWhiteSpace(filtro)
            ? cuentas!
            : cuentas!.Where(c => c.Nombre.Contains(filtro, StringComparison.CurrentCultureIgnoreCase)
                                  || c.Identificador.Contains(filtro, StringComparison.OrdinalIgnoreCase));

    private void Nuevo()
    {
        formulario = new Formulario();
        Error = Exito = null;
    }

    private void Editar(CuentaDto c)
    {
        var f = new Formulario { Id = c.Id, Identificador = c.Identificador, Nombre = c.Nombre, Correo = correos.TryGetValue(c.Id, out var u) ? u.CorreoExplicito : c.Correo };
        foreach (var r in c.Roles) { f.Roles.Add(r); }
        foreach (var a in c.Areas) { f.Areas.Add(a); }
        formulario = f;
        Error = Exito = null;
    }

    private void Cancelar() => formulario = null;

    private void AlternarRol(RolSistema rol, bool marcado)
    {
        if (marcado) { formulario!.Roles.Add(rol); } else { formulario!.Roles.Remove(rol); }
    }

    private void AlternarArea(string codigo, bool marcado)
    {
        if (marcado) { formulario!.Areas.Add(codigo); } else { formulario!.Areas.Remove(codigo); }
    }

    private async Task GuardarAsync()
    {
        var f = formulario!;
        var datos = new DatosCuenta(f.Nombre, f.Correo, f.Roles.ToList(), f.Areas.ToList());
        ocupado = true;
        try
        {
            if (f.Id is null)
            {
                ResultadoAlta? alta = null;
                if (await EjecutarAsync(async a => alta = await Cuentas.CrearAsync(a, f.Identificador, datos), "Usuario dado de alta."))
                {
                    contrasenaTemporal = alta!.ContrasenaTemporal;
                    temporalDe = alta.Identificador;
                    formulario = null;
                    await CargarAsync();
                    Exito ??= "Usuario dado de alta.";
                }
            }
            else if (await EjecutarAsync(a => Cuentas.ActualizarAsync(a, f.Id.Value, datos), "Cambios guardados."))
            {
                formulario = null;
                await CargarAsync();
                Exito ??= "Cambios guardados.";
            }
        }
        finally
        {
            ocupado = false;
        }
    }

    private async Task RestablecerAsync(CuentaDto c)
    {
        confirmandoRestablecer = null;
        string? temporal = null;
        if (await EjecutarAsync(async a => temporal = await Cuentas.RestablecerContrasenaAsync(a, c.Id)))
        {
            contrasenaTemporal = temporal;
            temporalDe = c.Identificador;
            await CargarAsync();
        }
    }

    private async Task CambiarEstadoAsync(CuentaDto c)
    {
        if (await EjecutarAsync(a => Cuentas.CambiarEstadoAsync(a, c.Id, !c.Activa)))
        {
            await CargarAsync();
            Exito = c.Activa ? $"{c.Identificador} quedó inactivo: ya no puede entrar." : $"{c.Identificador} quedó activo.";
        }
    }
}
