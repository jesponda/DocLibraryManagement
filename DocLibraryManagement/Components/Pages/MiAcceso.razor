@page "/mi-acceso"
@using DocLibraryManagement.Seguridad
@inject IConfiguration Configuracion

<PageTitle>Mi acceso</PageTitle>

<h1>Mi acceso</h1>

<AuthorizeView>
    <Authorized>
        @{
            var roles = context.User.ObtenerRoles().OrderBy(r => r).ToList();
            var areas = context.User.ObtenerAreas().OrderBy(a => a).ToList();
        }
        <dl class="row">
            <dt class="col-sm-3">Usuario</dt>
            <dd class="col-sm-9">@context.User.Identity?.Name</dd>

            <dt class="col-sm-3">Roles</dt>
            <dd class="col-sm-9">@string.Join(", ", roles)</dd>

            <dt class="col-sm-3">Áreas donde puede editar</dt>
            <dd class="col-sm-9">
                @if (roles.Contains(DocLibraryManagement.Domain.RolSistema.Administrador))
                {
                    <span>Todas (Administrador)</span>
                }
                else if (areas.Count == 0)
                {
                    <span>Ninguna</span>
                }
                else
                {
                    <span>@string.Join(", ", areas)</span>
                }
            </dd>
        </dl>
        @if (ConfiguracionSeguridad.ObtenerModo(Configuracion) == ConfiguracionSeguridad.ModoLocal)
        {
            @if (Cambiada == "1")
            {
                <div class="alert alert-success" role="status">Tu contraseña se cambió.</div>
            }
            <p class="text-muted">
                Tus roles y áreas los asigna un Administrador del sistema; si necesitas otros, pídeselos.
                <a href="cuenta/contrasena">Cambiar mi contraseña</a>.
            </p>
        }
        else
        {
            <p class="text-muted">
                Los roles se calculan a partir de tus grupos de Active Directory y pueden tardar unos minutos en actualizarse.
            </p>
        }
    </Authorized>
</AuthorizeView>

@code {
    [SupplyParameterFromQuery(Name = "cambiada")] private string? Cambiada { get; set; }
}
