@page "/documentos/{Id:int}"
@attribute [Authorize(Roles = "Autor,Administrador,Auditor,Revisor,Aprobador")]
@rendermode InteractiveServer
@inherits PaginaBase
@using DocLibraryManagement.Application.Catalogo
@using DocLibraryManagement.Application.Documentos
@using DocLibraryManagement.Domain
@inject ICatalogoService Catalogo
@inject IDocumentoService Servicio
@inject IRevisionService Revisiones

<PageTitle>@(doc?.Codigo ?? "Documento")</PageTitle>

<p><a href="documentos">← Documentos</a></p>

<Mensajes Error="@Error" Exito="@Exito" />

@if (cargando)
{
    <p>Cargando…</p>
}
else if (doc is null)
{
    @if (Error is null)
    {
        <h1>Documento no encontrado</h1>
    }
}
else
{
    <h1><code>@doc.Codigo</code></h1>
    <h2 class="h4">@doc.Titulo</h2>
    <p><a class="btn btn-outline-secondary btn-sm" href="documentos/@doc.Id/historial">Historial completo</a></p>

    <dl class="row" style="max-width: 50rem">
        <dt class="col-sm-3">Área</dt><dd class="col-sm-9">@doc.Area</dd>
        <dt class="col-sm-3">Subárea</dt>
        <dd class="col-sm-9">
            @if (puedeEditar && subAreas.Count > 0)
            {
                <select class="form-select form-select-sm d-inline-block w-auto" value="@subAreaElegida" @onchange="CambiarSubAreaAsync" aria-label="Subárea">
                    <option value="0">Sin subárea</option>
                    @foreach (var s in subAreas)
                    {
                        <option value="@s.Id">@s.Nombre</option>
                    }
                </select>
            }
            else
            {
                @(doc.SubArea ?? "—")
            }
        </dd>
        <dt class="col-sm-3">Tipo</dt><dd class="col-sm-9">@doc.Tipo</dd>
        <dt class="col-sm-3">Responsable</dt><dd class="col-sm-9">@doc.Responsable</dd>
        <dt class="col-sm-3">Creado</dt><dd class="col-sm-9">@doc.FechaCreacionUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
        <dt class="col-sm-3">Estado</dt><dd class="col-sm-9">@Presentacion.NombreEstado(doc.Estado)</dd>
    </dl>

    <h2 class="h5">Revisiones</h2>
    <table class="table table-sm align-middle" style="max-width: 50rem">
        <thead><tr><th>Revisión</th><th>Estado</th><th>Motivo</th><th>Autor</th><th>Fecha</th><th></th></tr></thead>
        <tbody>
        @foreach (var r in doc.Revisiones)
        {
            <tr class="@(r.Id == revisionId ? "table-active" : "")">
                <td>@r.Etiqueta</td>
                <td><span class="badge text-bg-secondary">@Presentacion.NombreEstado(r.Estado)</span></td>
                <td>@r.MotivoCambio</td>
                <td>@r.Autor</td>
                <td>@r.FechaCreacionUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                <td class="text-nowrap">
                    @if (r.Id != revisionId)
                    {
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => revisionId = r.Id">Ver</button>
                    }
                    @if (r.Estado != EstadoRevision.Cancelado)
                    {
                        <a class="btn btn-sm btn-link" href="doc/@doc.Codigo/@r.Etiqueta">Visor</a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>

    @if (puedeEditar && doc.Estado == EstadoDocumento.Activo && hayVigente && !hayAbierta)
    {
        <div class="mb-3" style="max-width: 50rem">
            <button class="btn btn-outline-primary" @onclick="() => abriendoRevision = !abriendoRevision">Nueva revisión…</button>
        </div>

        @if (abriendoRevision)
        {
            <div class="card border-primary mb-3" style="max-width: 50rem">
                <div class="card-header">Nueva revisión</div>
                <div class="card-body">
                    <div class="mb-2">
                        <label class="form-label" for="tipoRev">Tipo de cambio</label>
                        <select id="tipoRev" class="form-select" @bind="tipoNueva">
                            <option value="@((int)TipoRevisionNueva.Mayor)">Mayor – cambia requisitos, pasos o responsabilidades (flujo completo)</option>
                            <option value="@((int)TipoRevisionNueva.Menor)">Menor – corrección editorial (aprobación abreviada)</option>
                        </select>
                    </div>

                    @if (tipoNueva == (int)TipoRevisionNueva.Menor)
                    {
                        <div class="alert alert-info">
                            Una revisión menor se aprueba en una sola etapa por el
                            @if (nombreDueno is null)
                            {
                                <strong>dueño del área, que todavía no está designado</strong><span>: pide a un Administrador que lo designe.</span>
                            }
                            else
                            {
                                <span>dueño del área: <strong>@nombreDueno</strong>.</span>
                            }
                        </div>
                    }

                    <div class="mb-2">
                        <label class="form-label" for="motivoNueva">Motivo del cambio</label>
                        <input id="motivoNueva" class="form-control" maxlength="1000" @bind="motivoNueva" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="descNueva">Descripción <span class="text-muted">(opcional)</span></label>
                        <textarea id="descNueva" class="form-control" rows="2" maxlength="4000" @bind="descripcionNueva"></textarea>
                    </div>

                    @if (tipoNueva == (int)TipoRevisionNueva.Menor)
                    {
                        <div class="form-check mb-2">
                            <input id="declara" type="checkbox" class="form-check-input" @bind="declaraEditorial" />
                            <label class="form-check-label" for="declara">
                                Declaro que este cambio <strong>no altera requisitos, pasos ni responsabilidades</strong>.
                            </label>
                        </div>
                    }

                    <button class="btn btn-primary" @onclick="CrearRevisionAsync">Crear borrador</button>
                    <button class="btn btn-link" @onclick="() => abriendoRevision = false">Cancelar</button>
                </div>
            </div>
        }
    }

    @if (esAdmin && doc.Estado == EstadoDocumento.Activo)
    {
        <div class="mb-3" style="max-width: 50rem">
            <button class="btn btn-outline-secondary btn-sm" @onclick="AlternarCambioResponsableAsync">Cambiar responsable…</button>
            @if (cambiandoResponsable)
            {
                <div class="card border-secondary mt-2">
                    <div class="card-body">
                        <p class="mb-2">
                            Responsable actual: <strong>@doc.Responsable</strong>. La persona nueva recibirá los avisos de revisión periódica de este
                            documento y podrá declararlo <em>revisado sin cambios</em>. Solo aparecen personas activas que son Autores del área o
                            Administradores y que ya iniciaron sesión.
                        </p>
                        @if (candidatos.Count == 0)
                        {
                            <div class="alert alert-warning mb-2">No hay otra persona que pueda ser la responsable. Una persona nueva debe iniciar sesión al menos una vez.</div>
                        }
                        else
                        {
                            <label class="form-label" for="nuevoResponsable">Nuevo responsable</label>
                            <select id="nuevoResponsable" class="form-select mb-2" @bind="nuevoResponsable">
                                <option value="">Elige a una persona…</option>
                                @foreach (var c in candidatos)
                                {
                                    <option value="@c.Id">@c.NombreVisible (@c.Identificador)</option>
                                }
                            </select>
                            <label class="form-label" for="motivoResponsable">Motivo del cambio</label>
                            <input id="motivoResponsable" class="form-control mb-2" maxlength="1000" @bind="motivoResponsable" />
                            <button class="btn btn-primary" @onclick="CambiarResponsableAsync">Cambiar responsable</button>
                        }
                        <button class="btn btn-link" @onclick="() => cambiandoResponsable = false">Cerrar</button>
                    </div>
                </div>
            }
        </div>

        <div class="mb-3" style="max-width: 50rem">
            <button class="btn btn-outline-danger btn-sm" @onclick="() => retirando = !retirando">Retirar documento…</button>
            @if (retirando)
            {
                <div class="card border-danger mt-2">
                    <div class="card-body">
                        <p class="mb-2">
                            Es una <strong>baja sin sucesor</strong>: la revisión vigente pasará a obsoleta y se cancelará cualquier
                            borrador o flujo en curso. El código no se reutilizará. No se puede deshacer.
                        </p>
                        <label class="form-label" for="motivoRetiro">Motivo del retiro</label>
                        <input id="motivoRetiro" class="form-control mb-2" maxlength="1000" @bind="motivoRetiro" />
                        <button class="btn btn-danger" @onclick="RetirarAsync">Retirar documento</button>
                    </div>
                </div>
            }
        </div>
    }

    @if (revisionVigenteId != 0 && doc.Estado == EstadoDocumento.Activo)
    {
        <PanelRevisionPeriodica RevisionId="@revisionVigenteId" OnCambio="RecargarAsync" />
    }

    @if (revisionId != 0)
    {
        <PanelRevision RevisionId="@revisionId" OnCambio="RecargarAsync" />
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private DocumentoDetalleDto? doc;
    private List<SubAreaDto> subAreas = [];
    private int subAreaElegida;
    private int revisionId;
    private int revisionVigenteId;
    private bool puedeEditar;
    private bool esAdmin;
    private bool hayVigente;
    private bool hayAbierta;
    private string? nombreDueno;
    private bool cargando = true;

    private bool abriendoRevision;
    private int tipoNueva = (int)TipoRevisionNueva.Mayor;
    private string motivoNueva = "";
    private string descripcionNueva = "";
    private bool declaraEditorial;

    private bool retirando;
    private string motivoRetiro = "";

    private bool cambiandoResponsable;
    private IReadOnlyList<CandidatoResponsableDto> candidatos = [];
    private string nuevoResponsable = "";
    private string motivoResponsable = "";

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        revisionId = 0;
        await CargarAsync();
        cargando = false;
    }

    /// <summary>Recarga el documento conservando la revisión que se estaba viendo.</summary>
    private async Task RecargarAsync()
    {
        await CargarAsync();
        StateHasChanged();
    }

    private async Task CargarAsync()
    {
        var seleccionada = revisionId;
        doc = null;

        await EjecutarAsync(async a =>
        {
            doc = await Servicio.ObtenerAsync(a, Id);
            if (doc is null)
            {
                return;
            }

            puedeEditar = a.PuedeEditarEnArea(doc.CodigoArea);
            esAdmin = a.EsAdministrador;
            hayVigente = doc.Revisiones.Any(r => r.Estado == EstadoRevision.Vigente);
            revisionVigenteId = doc.Revisiones.FirstOrDefault(r => r.Estado == EstadoRevision.Vigente)?.Id ?? 0;
            hayAbierta = doc.Revisiones.Any(r => r.Estado.EsAbierta());
            var area = (await Catalogo.ListarAreasAsync(incluirInactivas: true)).FirstOrDefault(x => x.Id == doc.AreaId);
            nombreDueno = area?.NombreDueno;
            subAreas = [.. area?.SubAreas.Where(s => s.Activa) ?? []];
            subAreaElegida = doc.SubAreaId ?? 0;

            // La revisión más reciente es la que importa por defecto.
            revisionId = doc.Revisiones.Any(r => r.Id == seleccionada) ? seleccionada : doc.Revisiones.FirstOrDefault()?.Id ?? 0;
        });
    }

    private async Task CrearRevisionAsync()
    {
        RevisionDetalleDto? creada = null;
        var tipo = (TipoRevisionNueva)tipoNueva;

        if (await EjecutarAsync(async a =>
                creada = await Revisiones.CrearRevisionAsync(a, Id, tipo, motivoNueva, descripcionNueva, declaraEditorial)))
        {
            abriendoRevision = false;
            motivoNueva = descripcionNueva = "";
            declaraEditorial = false;
            revisionId = creada!.Id; // se abre el panel de la revisión recién creada
            await CargarAsync();
            Exito = $"Se abrió la {creada.Etiqueta} en borrador. Sube el PDF y envíala a revisión.";
        }
    }

    private async Task AlternarCambioResponsableAsync()
    {
        cambiandoResponsable = !cambiandoResponsable;
        if (cambiandoResponsable)
        {
            await EjecutarAsync(async a => candidatos = await Servicio.CandidatosResponsableAsync(a, Id));
        }
    }

    private async Task CambiarResponsableAsync()
    {
        if (!Guid.TryParse(nuevoResponsable, out var nuevoId))
        {
            Error = "Elige a la persona que será la responsable.";
            return;
        }

        var nombre = candidatos.FirstOrDefault(c => c.Id == nuevoId)?.NombreVisible ?? "la persona elegida";
        if (await EjecutarAsync(a => Servicio.CambiarResponsableAsync(a, Id, nuevoId, motivoResponsable)))
        {
            cambiandoResponsable = false;
            nuevoResponsable = motivoResponsable = "";
            await CargarAsync();
            Exito = $"El responsable ahora es {nombre}.";
        }
    }

    private async Task RetirarAsync()
    {
        if (await EjecutarAsync(a => Revisiones.RetirarDocumentoAsync(a, Id, motivoRetiro)))
        {
            retirando = false;
            motivoRetiro = "";
            await CargarAsync();
            Exito = "El documento fue retirado.";
        }
    }

    private async Task CambiarSubAreaAsync(ChangeEventArgs e)
    {
        var nueva = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        if (await EjecutarAsync(a => Servicio.CambiarSubAreaAsync(a, Id, nueva == 0 ? null : nueva), "Subárea actualizada."))
        {
            await CargarAsync();
        }
    }
}
